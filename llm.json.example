{
  "_comment": "Multi-LLM configuration for MCP Lens evaluation. Keys ending in '_env' reference environment variable names (set in .env), not raw values.",

  "default": "gemini-flash",

  "configs": {
    "gemini-flash": {
      "provider": "vertexai",
      "model": "gemini-2.5-flash",
      "_comment": "project and location are optional when using a service account — the SDK infers project from the credentials and defaults location to us-central1",
      "credentials_env": "GOOGLE_APPLICATION_CREDENTIALS"
    },
    "gemini-pro": {
      "provider": "vertexai",
      "model": "gemini-2.5-pro",
      "credentials_env": "GOOGLE_APPLICATION_CREDENTIALS"
    },
    "gemini-flash-custom-project": {
      "_comment": "Use project_env and location_env only if you need to override the service account defaults",
      "provider": "vertexai",
      "model": "gemini-2.5-flash",
      "project_env": "GCP_PROJECT",
      "location_env": "GCP_LOCATION",
      "credentials_env": "GOOGLE_APPLICATION_CREDENTIALS"
    },
    "claude": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "gpt4": {
      "provider": "openai",
      "model": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY"
    },
    "claude-vertex": {
      "provider": "anthropic-vertex",
      "model": "claude-sonnet-4-20250514",
      "project_env": "GCP_PROJECT",
      "location_env": "GCP_LOCATION",
      "credentials_env": "GOOGLE_APPLICATION_CREDENTIALS"
    }
  }
}
