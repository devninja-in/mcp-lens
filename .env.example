# Server ports
BACKEND_PORT=5002
FRONTEND_PORT=5173

# API authentication (optional — when set, all API routes require X-API-Key header)
# MCP_LENS_API_KEY=your-secret-api-key

# Database (optional, defaults to SQLite at ./mcp_secrets.db)
# DATABASE_URL=sqlite+aiosqlite:///mcp_secrets.db
# DATABASE_URL=postgresql://user:password@localhost:5432/mcp_tools_fetch

# Encryption key for secrets stored in the database (auto-generated by `make setup`)
# MCP_LENS_ENCRYPTION_KEY=base64-fernet-key-here

# Bearer tokens for MCP servers (format: MCP_{SERVER_NAME}_TOKEN)
# MCP_MYSERVER_TOKEN=your_jwt_token_here
# MCP_ANOTHER_SERVER_TOKEN=your_jwt_token_here

# OAuth client secrets (referenced by client_secret_env in server config)
# SLACK_CLIENT_SECRET=your_secret_here

# OAuth token persistence (default: false — tokens are deleted after tools fetch)
# Set to true to keep OAuth access/refresh tokens in the database across sessions
# PERSIST_OAUTH_TOKENS=false

# LLM Eval — configure in llm.json (see llm.json.example)
# Secrets referenced by llm.json via the _env suffix convention:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GCP_PROJECT=my-gcp-project
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
